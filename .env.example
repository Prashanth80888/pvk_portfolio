# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. Never commit the real .env.
# ---------------------------------------------------------------------------

# GEMINI_API_KEY: only needed if/when the server-side Gemini integration
# (POST /api/chat) is enabled. The current frontend does not call it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the app is hosted. Used in auto-reply email links.
APP_URL="https://your-domain.example"

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
# PORT: assigned by most hosting providers at runtime; defaults to 3000 locally.
PORT="3000"

# NODE_ENV: set to "production" for deployments.
NODE_ENV="development"

# TRUST_PROXY: set to "true" when running behind a trusted reverse proxy/load
# balancer (so client IPs are read from X-Forwarded-For for rate limiting).
# Defaults to true when NODE_ENV=production, false otherwise.
TRUST_PROXY="false"

# ---------------------------------------------------------------------------
# Contact form email delivery (SMTP). If these are left unset, contact messages
# are still stored server-side but no email is sent.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="your-smtp-username"
SMTP_PASS="your-smtp-password"

# Recipient that receives new contact-form notifications.
CONTACT_NOTIFY_EMAIL="you@example.com"
